---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for item in collections.all %}
  {%- if item.url and item.url != "/404.html" and not item.data.excludeFromSitemap %}
  <url>
    <loc>{{ site.url }}{{ item.url }}</loc>
    <changefreq>{{ item.data.changefreq | default("monthly") }}</changefreq>
    <priority>{{ item.data.priority | default("0.8") }}</priority>
  </url>
  {%- endif %}
{%- endfor %}
</urlset>

